# Public site origin used for canonical URLs, sitemap, robots.txt, and the contact form endpoint
NEXT_PUBLIC_SITE_URL=https://www.beaverbuilderssupply.com

# Contact form POST endpoint (Webstix / Supabase form portal)
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=https://ywwxvriolxwuqcwjaluh.supabase.co/functions/v1/form-submit/80c762ed-f07f-4120-a5b6-8e97d8164ea8
# Optional legacy inbox (only used by /api/contact FormSubmit fallback)
CONTACT_FORM_TO=keren@webstix.com

# Optional analytics (leave blank to disable)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-JMYL8FB9M1

# Cloudflare Turnstile (contact form bot protection)
# Store keys WITHOUT the 0x prefix — the app prepends 0x when calling Cloudflare.
# Site key is public (browser). Secret key stays server-only — never expose it as NEXT_PUBLIC_*.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
